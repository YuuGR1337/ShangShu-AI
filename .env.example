# ====================================================================
# 尚枢 AI · ShangShu AI - Docker 部署环境变量模板
# 使用方法：复制为 .env 并修改敏感值
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# ====================================================================

# !! 生产部署前必须修改以下值，否则存在安全风险 !!
#   AI_AUTH_JWT_SECRET   - 至少 32 字符随机字符串（JWT 签名密钥）
#   JASYPT_ENCRYPTOR_PASSWORD - 强密码（配置加密主密钥，丢失无法恢复加密字段）
#   MYSQL_ROOT_PASSWORD  - MySQL root 密码
#   REDIS_PASSWORD       - Redis 密码
# 生成随机密钥命令（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})

# ====================================================================
# 必填项
# ====================================================================

# JWT 签名密钥（至少 32 字符）
AI_AUTH_JWT_SECRET=请修改为至少32字符的随机字符串
# Jasypt 配置加密主密钥（生产环境务必使用强密码）
JASYPT_ENCRYPTOR_PASSWORD=请修改为强密码

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DB=ai_agent
MYSQL_USER=ai_agent
MYSQL_PASSWORD=请修改为强密码

# ---------- Redis ----------
REDIS_PASSWORD=请修改为强密码

# ====================================================================
# 可选项（有默认值）
# ====================================================================

# ---------- RabbitMQ ----------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=Admin@123456

# ---------- Ollama ----------
OLLAMA_MODEL_ID=qwen3:8b

# ---------- 模型 API Key ----------
# 不使用可留占位值（sk-placeholder），使用时替换
DEEPSEEK_API_KEY=sk-placeholder
QWEN_API_KEY=sk-placeholder

# ---------- JVM ----------
JAVA_OPTS=-Xms256m -Xmx512m

# ---------- 邮件（可选） ----------
# 不配置则邮件发送相关功能不可用（注册验证 / 找回密码）
SMTP_HOST=smtp.placeholder.local
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
AI_MAIL_FROM=noreply@ai-agent-platform.com
